#: cms_plugins/ajax_plugins.py:331
#, python-brace-format
msgid ""
"<blockquote style=\"color: var(--error-fg);\">Please get a public and secret "
"key from <a href=\"{key_link}\" target=\"_blank\">Google</a> and ensure that "
"they are available through django settings <code>RECAPTCHA_PUBLIC_KEY</code> "
"and <code>RECAPTCHA_PRIVATE_KEY</code>. Without these keys captcha "
"protection will not work.</blockquote>"
msgstr ""
"<blockquote style=\"color: var(--error-fg);\">Bitte erhalte einen "
"öffentlichen und einen geheimen Schlüssel bei <a href=\"{key_link}\" "
"target=\"_blank\">Google</a> und stelle sicher, dass sie über die Django-"
"Einstellungen <code>RECAPTCHA_PUBLIC_KEY</code> und "
"<code>RECAPTCHA_PRIVATE_KEY</code> verfügbar sind. Ohne Schlüssel kann keine "
"Captcha-Überprüfung durchgeführt werden.</blockquote>"

