#: cms_plugins/ajax_plugins.py:331
#, python-brace-format
msgid ""
"<blockquote style=\"color: var(--error-fg);\">Please get a public and secret "
"key from <a href=\"{key_link}\" target=\"_blank\">Google</a> and ensure that "
"they are available through django settings <code>RECAPTCHA_PUBLIC_KEY</code> "
"and <code>RECAPTCHA_PRIVATE_KEY</code>. Without these keys captcha "
"protection will not work.</blockquote>"
msgstr ""
"<blockquote style=\"color: var(--error-fg);\">Ju lutemi merrni një çelës "
"publik dhe një çelës sekret nga <a href=\"{key_link}\" "
"target=\"_blank\">Google</a> dhe sigurohuni që të jenë të disponueshëm "
"përmes cilësimeve të Django <code>RECAPTCHA_PUBLIC_KEY</code> dhe "
"<code>RECAPTCHA_PRIVATE_KEY</code>. Pa këta çelësa mbrojtja captcha nuk do "
"të funksionojë.</blockquote>"

